; Engine configuration file.
; Wave 1 — "Orchard Reach" Singapore open-world slice.
; Engine: Godot 4.7.1 stable (MIT), native macOS export.

config_version=5

[application]

config/name="Orchard Reach"
config/description="Original third-person open-world action slice set in a Singapore-inspired district."
run/main_scene="res://main.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssil/quality=2
environment/defaults/default_clear_color=Color(0.33, 0.52, 0.82, 1)
occlusion_culling/use_occlusion_culling=true

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60

[autoload]

Events="*res://src/core/events.gd"
Game="*res://src/core/game_state.gd"
Sfx="*res://src/core/audio.gd"
