# Godot engine cache and generated data
game/.godot/
game/.import/
game/build/
# Provider-generated assets: their terms are not MIT (see docs/ASSET_RIGHTS.md -
# per-asset redistribution clearance is incomplete and binaries are large), so they are staged locally and re-fetched with
# game/tools/fetch_provider_assets.sh
game/assets/providers/
game/captures/*.tmp

# macOS
.DS_Store

# Local editor / OS noise
*.swp

# Reproducible authoring intermediates
__pycache__/
*.blend1

# Provider-derived editable rigs retain the source rights restrictions
art/source/characters/
art/provider-sources/
